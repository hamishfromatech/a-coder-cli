<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Principal class: required for the app to become a foreground-capable
	     Cocoa application on macOS. Without this the bundle may not register
	     with the app switcher and the main window can fail to appear. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Ensure the app is treated as a modern Cocoa application, not a
	     Carbon/background process. Tauri v2 may inject LSRequiresCarbon;
	     explicitly disable it so the window is composited and activatable. -->
	<key>LSRequiresCarbon</key>
	<false/>

	<!-- Publisher / copyright shown in the macOS About box. -->
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 The A-Tech Corporation PTY LTD</string>
	<!-- Voice mode: microphone access for speech-to-text. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A-Coder Desktop uses the microphone for voice mode (speech-to-text).</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>A-Coder Desktop transcribes your speech to send as a prompt.</string>
</dict>
</plist>