{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "A-Coder Desktop",
	"version": "0.80.20",
	"identifier": "works.earendil.a-coder-desktop",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420"
	},
	"app": {
		"windows": [
			{
				"title": "A-Coder Desktop",
				"width": 1280,
				"height": 832,
				"minWidth": 900,
				"minHeight": 560,
				"resizable": true,
				"fullscreen": false,
				"center": true,
				"decorations": true,
				"visible": true,
				"focus": true,
				"skipTaskbar": false,
				"backgroundColor": "#0a0a0c",
				"acceptFirstMouse": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' https: http: ws: wss:; frame-src 'self' blob: data:",
			"capabilities": [
				"default"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"publisher": "The A-Tech Corporation PTY LTD",
		"createUpdaterArtifacts": false,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"infoPlist": "Info.plist"
		}
	},
	"plugins": {
		"shell": {
			"open": true
		},
		"updater": {
			"pubkey": "UPDATER_PUBKEY_PLACEHOLDER",
			"endpoints": [
				"https://github.com/hamishfromatech/pi-mono/releases/latest/download/latest.json"
			]
		}
	}
}
